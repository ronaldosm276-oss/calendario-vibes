{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calendar Gadget",
  "version": "0.1.0",
  "identifier": "com.personal.calendargadget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Calendar Gadget",
        "width": 760,
        "height": 680,
        "minWidth": 360,
        "minHeight": 360,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "skipTaskbar": false,
        "maximizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' https://www.googleapis.com https://oauth2.googleapis.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "google-client.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
